# Packaged HEOP installers are build outputs (created by pack.sh in APP/,
# then moved to output/ by makeapp.sh). Never commit them: a stale .app left
# in APP/ is packed into the next package and moved to output/ as well.
APP/*.app
/output/

# Local unit test binaries (built by hand with the host compiler, see tests/)
tests/*.exe
tests/*.o

# Python is only used for local helpers and scratch scripts, not the app
# itself. Note this only hides *untracked* files: check_model_bin.py and
# server/server.py were committed before this rule and stay tracked, so they
# keep showing up in git status. Run `git rm --cached <file>` to drop them.
*.py
*.pyc
__pycache__/
server/.venv/
